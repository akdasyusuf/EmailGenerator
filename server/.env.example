# Database Configuration
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_NAME=price_comparison
DB_PORT=5432

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret (for future authentication)
JWT_SECRET=your_jwt_secret_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Affiliate API Keys (for future use)
TRENDYOL_AFFILIATE_KEY=your_trendyol_key
HEPSIBURADA_AFFILIATE_KEY=your_hepsiburada_key
AMAZON_AFFILIATE_KEY=your_amazon_key
N11_AFFILIATE_KEY=your_n11_key
GITTIGIDIYOR_AFFILIATE_KEY=your_gittigidiyor_key

# Web Scraping Configuration
SCRAPER_TIMEOUT=30000
SCRAPER_CONCURRENT_REQUESTS=5
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36

# Redis Configuration (for future caching)
REDIS_URL=redis://localhost:6379

# Email Configuration (for future notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password

# Analytics
GOOGLE_ANALYTICS_ID=your_ga_id
FACEBOOK_PIXEL_ID=your_fb_pixel_id